# Copy this file to .env and fill in your keys

# ── Groq API (for RAG disease advice) ───────────────────────────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ── Groq Vision (optional — set to "none" if unavailable) ────────
VISION_MODEL=none

# ── Google Gemini Vision (FREE — recommended) ────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Disease model preprocessing (auto/raw/divide255) ─────────────
DISEASE_PREPROCESS=auto

# ── Database (SQLite default, or PostgreSQL) ──────────────────────
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/smart_cultivation

# ── JWT Auth ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_secret_in_production
JWT_EXPIRE_MINUTES=10080

# ── TensorFlow noise suppression ─────────────────────────────────
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
